{
  "$schema": "./components.schema.json",
  "schemaVersion": "1.0.0",
  "product": {
    "id": "plwc_windows",
    "name": "PLwC for Windows",
    "platform": "win32",
    "appDataRoot": "%APPDATA%\\PLwC",
    "releaseVersion": "1.0.0",
    "gatewayVersion": "1.0.0",
    "chatBridgeVersion": "1.0.0"
  },
  "installerTokens": {
    "{pythonExe}": "Absolute Python 3.11 or newer executable resolved by the installer.",
    "{extensionId}": "Stable PLwC Chat Bridge extension ID nlogfcafjdfdoknpkbehjgihpafpipdb.",
    "{browser}": "Selected native-messaging browser target: Chrome, Edge, Brave, Both, or All."
  },
  "managedDirectories": [
    {
      "id": "app",
      "path": "%APPDATA%\\PLwC\\app",
      "purpose": "Versioned application payloads and verified package copies.",
      "mutability": "installer_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": false
    },
    {
      "id": "workspace",
      "path": "%APPDATA%\\PLwC\\workspace",
      "purpose": "Default governed PLwC workspace.",
      "mutability": "user_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": true
    },
    {
      "id": "profiles",
      "path": "%APPDATA%\\PLwC\\profiles",
      "purpose": "Profile-owned governance, memory, persona, temperament, journal, and reflection state.",
      "mutability": "user_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": true
    },
    {
      "id": "config",
      "path": "%APPDATA%\\PLwC\\config",
      "purpose": "Runtime-wide configuration and installer-generated client descriptors.",
      "mutability": "user_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": true
    },
    {
      "id": "state",
      "path": "%APPDATA%\\PLwC\\state",
      "purpose": "Runtime-wide mutable state.",
      "mutability": "runtime_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": true
    },
    {
      "id": "logs",
      "path": "%APPDATA%\\PLwC\\logs",
      "purpose": "Runtime and installer logs.",
      "mutability": "runtime_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": true
    },
    {
      "id": "profile_backups",
      "path": "%APPDATA%\\PLwC\\profile_backups",
      "purpose": "Recoverable profile backups made before import, migration, or governed administration.",
      "mutability": "installer_managed",
      "preserveOnUpgrade": true,
      "preserveOnUninstall": true
    }
  ],
  "components": [
    {
      "id": "gateway_runtime",
      "displayName": "PLwC Gateway runtime",
      "kind": "gateway_runtime",
      "version": "1.0.0",
      "availability": "actual",
      "description": "Shared eight-tool plwc-gateway stdio runtime used by all selectable client integrations.",
      "selection": {
        "defaultSelected": true,
        "required": true,
        "visibility": "user"
      },
      "dependsOn": [],
      "installStrategy": {
        "mode": "copy_tree"
      },
      "payloads": [
        {
          "id": "gateway_runtime_tree",
          "role": "Executable Python gateway runtime extracted from the verified MCPB payload.",
          "source": {
            "path": "build\\mcpb\\plwc-gateway-1.0.0",
            "state": "actual",
            "repositoryTracked": false,
            "type": "directory"
          },
          "stage": {
            "path": "installer\\windows\\stage\\gateway",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "directory"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\gateway-1.0.0",
            "type": "directory",
            "overwritePolicy": "versioned_replace",
            "mutable": false
          },
          "required": true
        },
        {
          "id": "default_profile_template",
          "role": "Initial default profile template; existing profile data is never overwritten.",
          "source": {
            "path": "build\\mcpb\\plwc-gateway-1.0.0\\profiles\\template",
            "state": "actual",
            "repositoryTracked": false,
            "type": "directory"
          },
          "stage": {
            "path": "installer\\windows\\stage\\gateway\\profiles\\template",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "directory"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\profiles\\default",
            "type": "directory",
            "overwritePolicy": "create_if_missing",
            "mutable": true
          },
          "required": true
        },
        {
          "id": "security_config_example",
          "role": "Conservative security configuration example, not an implied active user configuration.",
          "source": {
            "path": "build\\mcpb\\plwc-gateway-1.0.0\\config\\security.yaml.example",
            "state": "actual",
            "repositoryTracked": false,
            "type": "file"
          },
          "stage": {
            "path": "installer\\windows\\stage\\gateway\\config\\security.yaml.example",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "file"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\config\\security.yaml.example",
            "type": "file",
            "overwritePolicy": "create_if_missing",
            "mutable": true
          },
          "required": true
        }
      ],
      "prerequisites": [
        {
          "id": "windows",
          "type": "operating_system",
          "name": "Windows",
          "scope": "install",
          "required": true,
          "detection": {
            "type": "installer_resolved",
            "value": "win32"
          }
        },
        {
          "id": "python",
          "type": "runtime",
          "name": "Python",
          "scope": "runtime",
          "required": true,
          "version": ">=3.11",
          "detection": {
            "type": "command",
            "value": "python --version"
          }
        },
        {
          "id": "python_dependencies",
          "type": "runtime",
          "name": "Python packages from requirements.txt",
          "scope": "runtime",
          "required": true,
          "version": "mcp; fastembed==0.8.0; qdrant-client==1.18.0",
          "detection": {
            "type": "command",
            "value": "{pythonExe} -c import mcp"
          }
        },
        {
          "id": "docker",
          "type": "optional_service",
          "name": "Docker Desktop",
          "scope": "runtime",
          "required": false,
          "detection": {
            "type": "command",
            "value": "docker version"
          }
        }
      ],
      "installerInputs": [
        {
          "id": "workspace_path",
          "type": "directory",
          "required": true,
          "default": "%APPDATA%\\PLwC\\workspace",
          "description": "Governed workspace root."
        },
        {
          "id": "profiles_path",
          "type": "directory",
          "required": true,
          "default": "%APPDATA%\\PLwC\\profiles",
          "description": "Profile root shared by selected PLwC clients."
        },
        {
          "id": "active_profile_name",
          "type": "string",
          "required": true,
          "default": "default",
          "validationPattern": "^[^\\\\/:*?\"<>|]+$",
          "description": "Initial active profile directory name."
        },
        {
          "id": "security_config",
          "type": "file",
          "required": false,
          "default": "",
          "description": "Optional active security.yaml; empty uses bundled conservative defaults."
        },
        {
          "id": "memory_write_threshold",
          "type": "string",
          "required": true,
          "default": "2",
          "validationPattern": "^[0-9]+$",
          "description": "Minimum confirmed evidence count for memory writes."
        },
        {
          "id": "persona_write_threshold",
          "type": "string",
          "required": true,
          "default": "3",
          "validationPattern": "^[0-9]+$",
          "description": "Minimum confirmed evidence count for persona writes."
        },
        {
          "id": "temperament_write_threshold",
          "type": "string",
          "required": true,
          "default": "2",
          "validationPattern": "^[0-9]+$",
          "description": "Minimum confirmed evidence count for temperament writes."
        },
        {
          "id": "qdrant_enabled",
          "type": "boolean",
          "required": true,
          "default": false,
          "description": "Optional Qdrant retrieval index, disabled by default."
        }
      ],
      "smokeChecks": [
        {
          "id": "gateway_stage_layout",
          "phase": "post_stage",
          "type": "path_contract",
          "required": true,
          "target": "installer\\windows\\stage\\gateway",
          "assertions": [
            {
              "subject": "server.py",
              "operator": "exists",
              "expected": true
            },
            {
              "subject": "src\\plwc_gateway\\mcp\\server.py",
              "operator": "exists",
              "expected": true
            },
            {
              "subject": "manifest.json",
              "operator": "exists",
              "expected": true
            }
          ]
        },
        {
          "id": "gateway_python_compile",
          "phase": "post_install",
          "type": "command",
          "required": true,
          "command": {
            "executable": "{pythonExe}",
            "arguments": [
              "-m",
              "compileall",
              "-q",
              "%APPDATA%\\PLwC\\app\\gateway-1.0.0"
            ]
          },
          "assertions": [
            {
              "subject": "exitCode",
              "operator": "equals",
              "expected": 0
            }
          ]
        },
        {
          "id": "gateway_mcp_contract",
          "phase": "post_install",
          "type": "mcp_contract",
          "required": true,
          "target": "%APPDATA%\\PLwC\\app\\gateway-1.0.0\\server.py",
          "assertions": [
            {
              "subject": "serverName",
              "operator": "equals",
              "expected": "plwc-gateway"
            },
            {
              "subject": "runtimeVersion",
              "operator": "equals",
              "expected": "1.0.0"
            },
            {
              "subject": "publicToolCount",
              "operator": "count_equals",
              "expected": 8
            }
          ]
        }
      ],
      "clientTargetIds": []
    },
    {
      "id": "claude_desktop_mcpb",
      "displayName": "MCPB for Claude Desktop",
      "kind": "claude_mcpb",
      "version": "1.0.0",
      "availability": "actual",
      "description": "Verified unsigned MCPB package staged for assisted installation in Claude Desktop.",
      "selection": {
        "defaultSelected": false,
        "required": false,
        "visibility": "user"
      },
      "dependsOn": [
        "gateway_runtime"
      ],
      "installStrategy": {
        "mode": "assisted"
      },
      "payloads": [
        {
          "id": "claude_mcpb_package",
          "role": "Unsigned privacy-filtered Claude Desktop MCPB package.",
          "source": {
            "path": "build\\mcpb\\plwc-gateway-1.0.0.mcpb",
            "state": "actual",
            "repositoryTracked": false,
            "type": "file"
          },
          "stage": {
            "path": "installer\\windows\\stage\\claude\\plwc-gateway-1.0.0.mcpb",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "file"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\packages\\plwc-gateway-1.0.0.mcpb",
            "type": "file",
            "overwritePolicy": "replace_if_hash_matches",
            "mutable": false
          },
          "required": true,
          "integrity": {
            "algorithm": "sha256",
            "value": "2f71ac903bf85cc70023805ec0f901e84c4294982c1b59940350db3591a2d345"
          }
        }
      ],
      "prerequisites": [
        {
          "id": "claude_desktop",
          "type": "application",
          "name": "Claude Desktop",
          "scope": "install",
          "required": true,
          "detection": {
            "type": "installer_resolved",
            "value": "Claude Desktop installation"
          }
        }
      ],
      "installerInputs": [],
      "smokeChecks": [
        {
          "id": "claude_mcpb_hash",
          "phase": "post_stage",
          "type": "hash_contract",
          "required": true,
          "target": "installer\\windows\\stage\\claude\\plwc-gateway-1.0.0.mcpb",
          "assertions": [
            {
              "subject": "sha256",
              "operator": "equals",
              "expected": "2f71ac903bf85cc70023805ec0f901e84c4294982c1b59940350db3591a2d345"
            }
          ]
        },
        {
          "id": "claude_mcpb_client_acceptance",
          "phase": "client_acceptance",
          "type": "manual_client_check",
          "required": true,
          "target": "Claude Desktop",
          "assertions": [
            {
              "subject": "visibleServerName",
              "operator": "equals",
              "expected": "plwc-gateway"
            },
            {
              "subject": "visiblePublicToolCount",
              "operator": "count_equals",
              "expected": 8
            }
          ]
        }
      ],
      "clientTargetIds": [
        "claude_desktop"
      ]
    },
    {
      "id": "codex_stdio",
      "displayName": "STDIO for Codex",
      "kind": "stdio_client",
      "version": "1.0.0",
      "availability": "prepared",
      "description": "Generates a conservative one-server stdio descriptor; direct Codex config mutation remains gated on a separately verified current schema.",
      "selection": {
        "defaultSelected": false,
        "required": false,
        "visibility": "user"
      },
      "dependsOn": [
        "gateway_runtime"
      ],
      "installStrategy": {
        "mode": "generate_config"
      },
      "payloads": [
        {
          "id": "codex_stdio_descriptor",
          "role": "Installer-generated Codex stdio descriptor derived from the real gateway manifest.",
          "source": {
            "path": "build\\mcpb\\plwc-gateway-1.0.0\\manifest.json",
            "state": "actual",
            "repositoryTracked": false,
            "type": "file"
          },
          "stage": {
            "path": "installer\\windows\\stage\\codex\\plwc-gateway.generated.toml",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "file"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\config\\clients\\codex\\plwc-gateway.generated.toml",
            "type": "file",
            "overwritePolicy": "backup_merge",
            "mutable": true
          },
          "required": true
        }
      ],
      "prerequisites": [
        {
          "id": "codex",
          "type": "application",
          "name": "Codex",
          "scope": "runtime",
          "required": true,
          "detection": {
            "type": "command",
            "value": "codex --version"
          }
        }
      ],
      "installerInputs": [
        {
          "id": "persona_layer_disabled",
          "type": "boolean",
          "required": true,
          "default": true,
          "description": "Conservative local-client default for explicit profile-context injection."
        }
      ],
      "smokeChecks": [
        {
          "id": "codex_descriptor_generated",
          "phase": "post_install",
          "type": "path_contract",
          "required": true,
          "target": "%APPDATA%\\PLwC\\config\\clients\\codex\\plwc-gateway.generated.toml",
          "assertions": [
            {
              "subject": "file",
              "operator": "exists",
              "expected": true
            },
            {
              "subject": "serverName",
              "operator": "equals",
              "expected": "plwc-gateway"
            }
          ]
        },
        {
          "id": "codex_client_acceptance",
          "phase": "client_acceptance",
          "type": "manual_client_check",
          "required": true,
          "target": "Codex",
          "assertions": [
            {
              "subject": "visibleServerName",
              "operator": "equals",
              "expected": "plwc-gateway"
            },
            {
              "subject": "visiblePublicToolCount",
              "operator": "count_equals",
              "expected": 8
            }
          ]
        }
      ],
      "clientTargetIds": [
        "codex"
      ]
    },
    {
      "id": "odysseus_stdio",
      "displayName": "STDIO for Odysseus",
      "kind": "stdio_client",
      "version": "1.0.0",
      "availability": "prepared",
      "description": "Generates a portable one-server stdio descriptor for assisted Odysseus configuration.",
      "selection": {
        "defaultSelected": false,
        "required": false,
        "visibility": "user"
      },
      "dependsOn": [

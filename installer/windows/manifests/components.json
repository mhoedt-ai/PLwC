            }
          ]
        }
      ],
      "clientTargetIds": [
        "odysseus"
      ]
    },
    {
      "id": "chat_bridge",
      "displayName": "PLwC Chat Bridge",
      "kind": "chat_bridge",
      "version": "1.0.0",
      "availability": "prepared",
      "description": "Stages the built loopback bridge and unpacked browser extension and prepares the Windows native launcher for Reconnect autostart.",
      "selection": {
        "defaultSelected": false,
        "required": false,
        "visibility": "user"
      },
      "dependsOn": [
        "gateway_runtime"
      ],
      "installStrategy": {
        "mode": "build_and_copy",
        "preparationCommands": [
          {
            "executable": "npm",
            "arguments": [
              "ci"
            ],
            "workingDirectory": "integrations\\plwc-chat-bridge\\bridge"
          },
          {
            "executable": "npm",
            "arguments": [
              "ci"
            ],
            "workingDirectory": "integrations\\plwc-chat-bridge\\extension"
          },
          {
            "executable": "npm",
            "arguments": [
              "run",
              "check"
            ],
            "workingDirectory": "integrations\\plwc-chat-bridge"
          }
        ]
      },
      "payloads": [
        {
          "id": "bridge_runtime",
          "role": "Compiled loopback WebSocket-to-MCP bridge JavaScript.",
          "source": {
            "path": "integrations\\plwc-chat-bridge\\bridge\\dist",
            "state": "actual",
            "repositoryTracked": false,
            "type": "directory"
          },
          "stage": {
            "path": "installer\\windows\\stage\\chat-bridge\\bridge\\dist",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "directory"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\chat-bridge-1.0.0\\bridge\\dist",
            "type": "directory",
            "overwritePolicy": "versioned_replace",
            "mutable": false
          },
          "required": true
        },
        {
          "id": "bridge_production_dependencies",
          "role": "Production Node dependencies materialized from the pinned bridge lockfile during staging.",
          "source": {
            "path": "integrations\\plwc-chat-bridge\\bridge\\package-lock.json",
            "state": "actual",
            "repositoryTracked": true,
            "type": "file"
          },
          "stage": {
            "path": "installer\\windows\\stage\\chat-bridge\\bridge\\node_modules",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "directory"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\chat-bridge-1.0.0\\bridge\\node_modules",
            "type": "directory",
            "overwritePolicy": "versioned_replace",
            "mutable": false
          },
          "required": true
        },
        {
          "id": "browser_extension",
          "role": "Built Manifest V3 unpacked extension for chatgpt.com and chat.openai.com.",
          "source": {
            "path": "integrations\\plwc-chat-bridge\\extension\\dist",
            "state": "actual",
            "repositoryTracked": false,
            "type": "directory"
          },
          "stage": {
            "path": "installer\\windows\\stage\\chat-bridge\\extension",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "directory"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\chat-bridge-1.0.0\\extension",
            "type": "directory",
            "overwritePolicy": "versioned_replace",
            "mutable": false
          },
          "required": true
        },
        {
          "id": "bridge_config",
          "role": "Rendered loopback-only bridge configuration targeting the installed gateway runtime.",
          "source": {
            "path": "integrations\\plwc-chat-bridge\\config\\plwc.example.json",
            "state": "actual",
            "repositoryTracked": true,
            "type": "file"
          },
          "stage": {
            "path": "installer\\windows\\stage\\chat-bridge\\config\\plwc.example.json",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "file"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\chat-bridge-1.0.0\\config\\plwc.json",
            "type": "file",
            "overwritePolicy": "backup_merge",
            "mutable": true
          },
          "required": true
        },
        {
          "id": "bridge_start_script",
          "role": "Internal hidden-launch helper used by the native launcher; not the user-facing installer entry point.",
          "source": {
            "path": "integrations\\plwc-chat-bridge\\scripts\\start-windows.ps1",
            "state": "actual",
            "repositoryTracked": true,
            "type": "file"
          },
          "stage": {
            "path": "installer\\windows\\stage\\chat-bridge\\scripts\\start-windows.ps1",
            "state": "prepared",
            "repositoryTracked": false,
            "type": "file"
          },
          "destination": {
            "path": "%APPDATA%\\PLwC\\app\\chat-bridge-1.0.0\\scripts\\start-windows.ps1",
            "type": "file",
            "overwritePolicy": "versioned_replace",
            "mutable": false
          },
          "required": true
        },
        {
          "id": "bridge_healthcheck_script",
          "role": "Internal health check invoked by the native launcher after starting the bridge.",
          "source": {
            "path": "integrations\\plwc-chat-bridge\\bridge\\scripts\\healthcheck.mjs",
            "state": "actual",
            "repositoryTracked": true,
            "type": "file"

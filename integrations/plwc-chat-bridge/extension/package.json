{
  "name": "@plwc/chat-bridge-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:store:windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-store-packages.ps1",
    "build:fixture": "node ./scripts/build-browser-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/test.mjs",
    "test:store:windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-store-packages.ps1",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
